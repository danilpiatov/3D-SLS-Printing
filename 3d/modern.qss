QWidget {
    background-color: #f5f6fa;
    font-family: 'Segoe UI', sans-serif;
    font-size: 14px;
}

QGroupBox {
    border: 1px solid #dcdde1;
    border-radius: 6px;
    margin-top: 20px;
    padding-top: 25px;
    color: #2f3640;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

QPushButton {
    background-color: #b2928d;
    color: #1a1b38;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #82645e;
    color: #1a1b38;
}

QToolButton {
    background-color: #b2928d;
    color: #1a1b38;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    min-width: 80px;
}

QToolButton:hover {
    background-color: #82645e;
    color: #1a1b38;
}

QPushButton:disabled {
    background-color: #26547C;
    color: #26547C;
}

QLineEdit {
    border: 1px solid #dcdde1;
    border-radius: 4px;
    padding: 6px;
    background: white;
    selection-background-color: #7f8fa6;
}

QLineEdit:focus {
    border-color: #7f8fa6;
}

QCheckBox {
    spacing: 5px;
    color: #2f3640;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #dcdde1;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #718093;
    image: url(:/icons/check.svg);
}

MyArea {
    background-color: white;
    border: 1px solid #6D87A8;
    border-radius: 6px;
}
QMainWindow {
    background: #F5F6FA;
    font-family: 'Segoe UI';
}

/* Стили для QTabWidget */
QTabWidget {
    background: transparent;
    border: none;
}

QTabBar {
    background: transparent;
    spacing: 8px;
}

QTabBar::tab {
    background: #FFFFFF;
    color: #666666;
    padding: 12px 24px;
    border: none;
    border-radius: 6px;
    font-size: 12px;
    min-width: 120px;
    margin-right: 4px;
    transition: all 0.3s ease;
}

QTabBar::tab:selected {
    background: #0078D4;
    color: #FFFFFF;
    box-shadow: 0 4px 12px rgba(0, 120, 212, 0.3);
}

QTabBar::tab:hover {
    background: #E5F1FB;
    color: #0078D4;
}

QTabWidget::pane {
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    margin-top: 8px;
    background: #FFFFFF;
    padding: 12px;
}

/* Дополнительные эффекты */
QTabWidget QScrollArea {
    border: none;
    background: transparent;
}

QTableView {
    background: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    gridline-color: #F0F0F0;
    alternate-background-color: #F8F9FA;
    selection-background-color: #E3F2FD;
    selection-color: #0078D4;
    font-size: 12px;
}

QHeaderView {
    background: #FFFFFF;
    border: none;
}

QHeaderView::section {
    background: #F5F5F5;
    color: #666666;
    padding: 12px;
    border: none;
    border-bottom: 2px solid #0078D4;
    font-weight: 500;
}

QTableView::item {
    padding: 10px;
    border-bottom: 1px solid #F0F0F0;
    border:none;
}

QTableView::item:selected {
    background: #E3F2FD;
    color: #0078D4;
    font-weight: bold;
    border:none;
    outline: none;
}
QTableView::item:focus {
    border: none;
    outline: none;
}

/* Кнопки в таблице */
QTableView QPushButton {
    background: #0078D4;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    min-width: 80px;
}

QTableView QPushButton:hover {
    background: #0062A3;
}

/* Иконки действий */
QTableView QToolButton {
    background: transparent;
    border: none;
    padding: 5px;
}

QTableView QToolButton:hover {
    background: #F0F0F0;
    border-radius: 4px;
    border:none;
}