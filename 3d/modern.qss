QWidget {
    background-color: #f5f6fa;
    font-family: 'Segoe UI', sans-serif;
    font-size: 14px;
}

QGroupBox {
    border: 1px solid #dcdde1;
    border-radius: 6px;
    margin-top: 20px;
    padding-top: 25px;
    color: #2f3640;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

QPushButton {
    background-color: #b2928d;
    color: #1a1b38;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #82645e;
    color: #1a1b38;
}

QToolButton {
    background-color: #b2928d;
    color: #1a1b38;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    min-width: 80px;
}

QToolButton:hover {
    background-color: #82645e;
    color: #1a1b38;
}

QPushButton:disabled {
    background-color: #26547C;
    color: #26547C;
}

QLineEdit {
    border: 1px solid #dcdde1;
    border-radius: 4px;
    padding: 6px;
    background: white;
    selection-background-color: #7f8fa6;
}

QLineEdit:focus {
    border-color: #7f8fa6;
}

QCheckBox {
    spacing: 5px;
    color: #2f3640;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #dcdde1;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #718093;
    image: url(:/icons/check.svg);
}

MyArea {
    background-color: white;
    border: 1px solid #6D87A8;
    border-radius: 6px;
}